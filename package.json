{
  "name": "@sentry/tattletale",
  "version": "0.2.2",
  "description": "Tattles on your coding agents: ships Claude Code and Codex sessions to Sentry agent tracing as gen_ai spans.",
  "keywords": [
    "agent-tracing",
    "claude-code",
    "codex",
    "gen_ai",
    "opentelemetry",
    "sentry"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsentry/tattletale.git"
  },
  "bin": {
    "tattletale": "dist/cli.js"
  },
  "files": [
    "dist",
    "hooks",
    "skills",
    ".claude-plugin",
    ".codex-plugin",
    ".agents",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --no-warnings --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "verify:local": "node --no-warnings src/cli.ts verify --days 30",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.2"
}
